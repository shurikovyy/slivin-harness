#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

run_python() {
  if [[ -n "${SLIVIN_HARNESS_PYTHON:-}" ]]; then
    exec "$SLIVIN_HARNESS_PYTHON" "$ROOT/task_runner.py" "$@"
  fi

  if command -v python3 >/dev/null 2>&1; then
    exec python3 "$ROOT/task_runner.py" "$@"
  fi

  if command -v python >/dev/null 2>&1; then
    exec python "$ROOT/task_runner.py" "$@"
  fi

  if command -v py >/dev/null 2>&1; then
    exec py -3 "$ROOT/task_runner.py" "$@"
  fi

  echo "Slivin Harness requires Python 3.11+. Set SLIVIN_HARNESS_PYTHON or put Python on PATH." >&2
  exit 127
}

run_python "$@"
