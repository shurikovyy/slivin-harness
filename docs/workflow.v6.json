    "task_contract",
    "plan",
    "implementation_contract",
    "verification_plan",
    "candidate",
    "runtime_environment"
  ],
  "invalidation_rules": [
    {
      "trigger": "TASK_CONTRACT_CHANGED",
      "invalidate_from": "planner",
      "restart_at": "planner",
      "new_attempt_required": true,
      "delivery_only": false,
      "reason": "Изменение пользовательского контракта инвалидирует всё техническое reasoning."
    },
    {
      "trigger": "REPLAN_REQUIRED",
      "invalidate_from": "planner",
      "restart_at": "planner",
      "new_attempt_required": true,
      "delivery_only": false,
      "reason": "Ошибка технической модели требует нового независимого planning attempt."
    },
    {
      "trigger": "CONTRACT_EXPANDED",
      "invalidate_from": "implementation_contract",
      "restart_at": "implementation_contract",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Новый consumer/risk меняет Definition of Done и обнуляет downstream evidence."
    },
    {
      "trigger": "CHECK_REGISTERED",
      "invalidate_from": "implementation_contract",
      "restart_at": "implementation_contract",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Новая authoritative проверка должна войти в self-verify и все последующие gates."
    },
    {
      "trigger": "CANDIDATE_CHANGED",
      "invalidate_from": "implementer",
      "restart_at": "implementer",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Любое изменение candidate делает прежние проверки устаревшими."
    },
    {
      "trigger": "DEPENDENCY_MANIFEST_CHANGED",
      "invalidate_from": "implementer",
      "restart_at": "implementer",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Изменение dependency declaration требует rebuild runtime и повторного evidence."
    },
    {
      "trigger": "RUNTIME_ENV_CHANGED",
      "invalidate_from": "implementer",
      "restart_at": "implementer",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Evidence другого runtime environment не переносится автоматически."
    },
    {
      "trigger": "RUNTIME_PROFILE_CHANGED",
      "invalidate_from": "runtime_verification",
      "restart_at": "runtime_verification",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Новый runtime proof profile инвалидирует runtime, evaluator и final gate."
    },
    {
      "trigger": "SOURCE_CHANGED",
      "invalidate_from": null,
      "restart_at": "final_gate",
      "new_attempt_required": false,
      "delivery_only": true,
      "reason": "Изменение source checkout не портит accepted candidate, но блокирует delivery."
    },
    {
      "trigger": "HIDDEN_GRADER_CHANGED",
      "invalidate_from": "final_gate",
      "restart_at": "final_gate",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Изменение hidden grader требует новой calibration перед benchmark final gate."
    },
    {
      "trigger": "CANDIDATE_CHANGED_AFTER_EVALUATION",
      "invalidate_from": "implementer",
      "restart_at": "implementer",
      "new_attempt_required": false,
      "delivery_only": false,
      "reason": "Candidate mutation после evaluation инвалидирует implementation evidence и все gates."
    }
  ]
}
