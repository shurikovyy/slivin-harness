  "stages": [
    {
      "number": 0,
      "stage_id": "intake_preflight",
      "title": "Intake / Preflight",
      "purpose": "Фиксирует задачу, baseline, workspace и доступные инструменты.",
      "success_codes": [
        "PREFLIGHT_READY"
      ],
      "skip_codes": [],
      "optional": false,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 1,
      "stage_id": "planner",
      "title": "Planner",
      "purpose": "Read-only исследование и техническая модель задачи.",
      "success_codes": [
        "PLANNER_READY",
        "PLANNER_SKIPPED_FAST"
      ],
      "skip_codes": [
        "PLANNER_SKIPPED_FAST"
      ],
      "optional": false,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 2,
      "stage_id": "implementation_contract",
      "title": "Implementation Contract",
      "purpose": "Controller превращает load-bearing выводы в обязательный минимум результата.",
      "success_codes": [
        "IMPLEMENTATION_CONTRACT_READY"
      ],
      "skip_codes": [],
      "optional": false,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 3,
      "stage_id": "implementer",
      "title": "Implementer",
      "purpose": "Создаёт candidate, tests/docs и собственное evidence.",
      "success_codes": [
        "IMPLEMENTATION_COMPLETE"
      ],
      "skip_codes": [],
      "optional": false,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 4,
      "stage_id": "deterministic_checks",
      "title": "Controller deterministic checks",
      "purpose": "Независимо запускает локальные машинные проверки candidate.",
      "success_codes": [
        "DETERMINISTIC_VERIFICATION_PASS"
      ],
      "skip_codes": [],
      "optional": false,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 5,
      "stage_id": "runtime_verification",
      "title": "Runtime / external verification",
      "purpose": "Условно проверяет observable runtime outcome, если local checks недостаточны.",
      "success_codes": [
        "RUNTIME_VERIFICATION_PASS",
        "RUNTIME_VERIFICATION_SKIPPED"
      ],
      "skip_codes": [
        "RUNTIME_VERIFICATION_SKIPPED"
      ],
      "optional": true,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 6,
      "stage_id": "evaluator",
      "title": "Blind Evaluator",
      "purpose": "Независимо пытается опровергнуть полноту и корректность candidate.",
      "success_codes": [
        "EVALUATION_PASS",
        "EVALUATION_SKIPPED_FAST"
      ],
      "skip_codes": [
        "EVALUATION_SKIPPED_FAST"
      ],
      "optional": false,
      "maturity": "IMPLEMENTED"
    },
    {
      "number": 7,
      "stage_id": "final_gate",
      "title": "Final Gate / result handoff",
      "purpose": "Сверяет identity доказательств и безопасно выдаёт принятый result.",
      "success_codes": [
        "HARNESS_TASK_PASS",
        "HARNESS_BENCHMARK_PASS"
      ],
      "skip_codes": [],
      "optional": false,
      "maturity": "IMPLEMENTED"
    }
  ],
  "success_next": {
    "intake_preflight": "planner",
    "planner": "implementation_contract",
    "implementation_contract": "implementer",
    "implementer": "deterministic_checks",
    "deterministic_checks": "runtime_verification",
    "runtime_verification": "evaluator",
    "evaluator": "final_gate",
    "final_gate": null
  },
  "allowed_transitions": {
    "<START>": [
      "intake_preflight"
    ],
    "intake_preflight": [
      "planner"
    ],
    "planner": [
      "implementation_contract"
    ],
    "implementation_contract": [
      "implementer"
    ],
    "implementer": [
      "deterministic_checks"
    ],
    "deterministic_checks": [
      "implementer",
      "runtime_verification"
    ],
    "runtime_verification": [
      "evaluator",
      "implementer"
    ],
    "evaluator": [
      "final_gate",
      "implementer",
      "planner"
    ],
    "final_gate": []
  },
  "routing_outcomes": [
